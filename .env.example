OPENROUTER_API_KEY=.       # API key for OpenRouter (https://openrouter.ai/)
OPENROUTER_MODEL=                        # OpenRouter model id (e.g. openai/gpt-5.4-mini); defaults to openai/gpt-5.4-mini
OPENROUTER_MODEL_CONTEXT_WINDOW_TOKENS=  # Context window in tokens for OPENROUTER_MODEL; only needed if it differs from the 400.000-token default

DISCORD_PUBLIC_KEY=        # verifies X-Signature-Ed25519 + X-Signature-Timestamp on button presses (approvals)
DISCORD_APPLICATION_ID=    # Discord application id
DISCORD_BOT_TOKEN=         # agent: replies, threads, typing indicators; relay: Gateway connection
DISCORD_RELAY_SECRET=      # shared secret between relay and agent (openssl rand -hex 32); the agent refuses to start without it
EVE_URL=                   # relay only: agent base URL (http://mike:3000 in Compose; the URL `pnpm dev` prints locally)

GITHUB_TOKEN=              # PAT with 'repo' scope for creating issues

DATABASE_PATH=             # SQLite file for memory; defaults to ./data/mike.db (/app/data/mike.db in Docker)
