OPENROUTER_API_KEY=.       # API key for OpenRouter (https://openrouter.ai/)
OPENROUTER_MODEL=                        # OpenRouter model id (e.g. openai/gpt-5.4-mini); defaults to openai/gpt-5.4-mini
OPENROUTER_MODEL_CONTEXT_WINDOW_TOKENS=  # Context window in tokens for OPENROUTER_MODEL; only needed if it differs from the 400.000-token default

DISCORD_PUBLIC_KEY=        # verifies X-Signature-Ed25519 + X-Signature-Timestamp
DISCORD_APPLICATION_ID=    # edits deferred response + sends followups
DISCORD_BOT_TOKEN=         # proactive messages, fallback, typing indicators

GITHUB_TOKEN=              # PAT with 'repo' scope for creating issues

BLOB_BUNNY_URL=            # base URL of the blob-bunny server backing agent memory (https, no trailing slash needed)
BLOB_BUNNY_TOKEN=          # bearer token for blob-bunny (BLOB_BUNNY_API_TOKEN on the server)